                  >
                    <div
                      class="dropdown w-full"
                    >
                      <button
                        aria-controls="_r_2d_"
                        aria-expanded="false"
                        aria-haspopup="listbox"
                        class="btn btn-outline w-full text-left flex justify-between items-center "
                        id="root_answer"
                        role="combobox"
                        tabindex="0"
                        type="button"
                      >
                        <span
                          class="truncate"
                        >
                          Yes
                        </span>
                        <span
                          aria-hidden="true"
                          class="ml-2"
                        >
