exports[`single fields > schema examples with mixed types (string examples and number default) 1`] = `
<DocumentFragment>
  <form
    class="rjsf"
  >
    <div
      class="flex-grow rjsf-field rjsf-field-integer"
    >
      <div
        class="field-template mb-3"
      >
        <input
          aria-describedby="root__examples"
          class="input input-bordered w-full"
          id="root"
          inputmode="numeric"
          label=""
          list="root__examples"
          name="root"
          pattern="[+\\-]?([0-9]+[.][0-9]+[eE]\\+?[0-9]+|[0-9]+([eE]\\+?[0-9]+|[.]0*)?|[.])"
          placeholder=""
          title="Enter a whole number"
          type="text"
          value="5432"
        />
        <datalist
          id="root__examples"
        >
          <option
            value="5432"
          />
          <option
            value="3306"
          />
          <option
            value="1433"
          />
