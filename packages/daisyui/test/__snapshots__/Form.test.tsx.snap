          <svg
            aria-hidden="true"
            class="rjsf-button-icon h-5 w-5"
            fill="none"
            height="1em"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 16 16"
            width="1em"
          >
            <path
              d="M4 4l8 8M12 4l-8 8"
            />
          </svg>
        </button>
      </div>
    </div>
    <div>
      <button
        class="rjsf-submit-button btn btn-primary btn-primary-content"
        type="submit"
      >
        Submit
      </button>
    </div>
  </form>
</DocumentFragment>
`;

