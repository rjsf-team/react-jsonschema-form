<DocumentFragment>
  <form
    class="rjsf"
  >
    <div
      class="flex-grow rjsf-field rjsf-field-string"
    >
      <div
        class="field-template mb-3"
      >
        <div
          class="form-control my-4 w-full relative"
        >
          <div
            class="w-full"
          >
            <button
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-label="Select a date"
              class="input input-bordered w-full flex items-center justify-between cursor-pointer "
              id="root"
              role="combobox"
              type="button"
            >
              <span
                aria-hidden="true"
                class="text-base-content/50"
              >
                Select a date
              </span>
              <svg
                aria-hidden="true"
                class="svg-inline--fa fa-calendar ml-2 h-4 w-4 text-primary"
                data-icon="calendar"
                data-prefix="fas"
                role="img"
                viewBox="0 0 448 512"
              >
                <path
                  d="M128 0C110.3 0 96 14.3 96 32l0 32-32 0C28.7 64 0 92.7 0 128l0 48 448 0 0-48c0-35.3-28.7-64-64-64l-32 0 0-32c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 32-128 0 0-32c0-17.7-14.3-32-32-32zM0 224L0 416c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-192-448 0z"
                  fill="currentColor"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
    <div>
      <button
        class="rjsf-submit-button btn btn-primary btn-primary-content"
        type="submit"
      >
        Submit
      </button>
    </div>
  </form>
</DocumentFragment>
`;

