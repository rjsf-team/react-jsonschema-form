                aria-selected="false"
                class="px-4 py-2 hover:bg-base-200 cursor-pointer "
                data-value="0"
                role="option"
                tabindex="-1"
              >
                <div
                  class="flex items-center gap-2"
                >
                  <span>
                    Number
                  </span>
                </div>
              </li>
              <li
                aria-selected="true"
                class="px-4 py-2 hover:bg-base-200 cursor-pointer bg-primary/10"
                data-value="1"
                role="option"
                tabindex="-1"
              >
                <div
                  class="flex items-center gap-2"
                >
                  <span>
                    String
                  </span>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div>
      <button
        class="rjsf-submit-button btn btn-primary btn-primary-content"
        type="submit"
      >
        Submit
      </button>
    </div>
  </form>
</DocumentFragment>
`;

