exports[`error state > ui:hideError on a parent keeps its children out of the error state 1`] = `
<DocumentFragment>
  <form
    class="rjsf"
  >
    <div
      class="error-list"
    >
      <ul
        class="list-disc list-inside text-red-600"
      >
        <li>
          .marketType must be equal to one of the allowed values
        </li>
        <li>
          .commissioning must match format "year"
        </li>
        <li>
          .regions must NOT have fewer than 1 items
        </li>
        <li>
          .tier must be equal to one of the allowed values
        </li>
        <li>
          .active must be checked
        </li>
        <li>
          .notes must NOT have more than 10 characters
        </li>
        <li>
          .quantity must be an integer
        </li>
        <li>
          .threshold must be &lt;= 10
        </li>
        <li>
          .secret must NOT have fewer than 8 characters
        </li>
        <li>
          .shade must match format "color"
        </li>
        <li>
          .startsOn must match format "date"
        </li>
        <li>
          .startsAt must match format "date-time"
        </li>
        <li>
          .opensAt must match format "time"
        </li>
        <li>
          .endsOn must match format "date"
        </li>
        <li>
          .attachment must match format "data-url"
        </li>
      </ul>
    </div>
    <div
      class="flex-grow rjsf-field rjsf-field-object"
