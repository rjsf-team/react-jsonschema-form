          id="root__add"
          title="Add"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="rjsf-button-icon"
            fill="none"
            height="1em"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 16 16"
            width="1em"
          >
            <path
              d="M8 3v10M3 8h10"
            />
          </svg>
        </button>
      </fieldset>
    </div>
    <div>
      <button
        class="rjsf-submit-button"
        type="submit"
      >
        Submit
      </button>
    </div>
  </form>
</DocumentFragment>
`;

