                aria-describedby="root_0__description"
                id="root_0"
                label="Test item"
                name="root_0"
                placeholder=""
                required=""
                type="text"
                value=""
              />
            </div>
          </div>
          <div
            class="rjsf-array-item"
          >
            <div
              class="rjsf-field rjsf-field-number"
            >
              <label
                class="rjsf-field-label"
                for="root_1"
              >
                <span
                  id="root_1__label"
                >
                  Test item
                </span>
                <span
                  class="rjsf-required"
                >
                  *
                </span>
              </label>
              <div
                class="rjsf-field-description"
                id="root_1__description"
              >
                a test item description
              </div>
              <input
                aria-describedby="root_1__description"
                id="root_1"
                inputmode="decimal"
                label="Test item"
                name="root_1"
                pattern="[+\\-]?(([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+\\-]?[0-9]+)?|[.])"
                placeholder=""
                required=""
                title="Enter a number"
                type="text"
                value=""
              />
            </div>
          </div>
        </div>
      </fieldset>
    </div>
    <div>
      <button
        class="rjsf-submit-button"
        type="submit"
      >
        Submit
      </button>
    </div>
  </form>
</DocumentFragment>
`;

