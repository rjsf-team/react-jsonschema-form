              >
                <span
                  id="root_customField__label"
                >
                  customField
                </span>
              </label>
              <input
                id="root_customField"
                label="customField"
                name="root[customField]"
                placeholder=""
                type="text"
                value="customValue"
              />
            </div>
            <button
              aria-label="Remove"
              class="rjsf-button rjsf-button-danger rjsf-object-property-remove"
              id="root_customField__remove"
              title="Remove"
              type="button"
            >
              <svg
                aria-hidden="true"
                class="rjsf-button-icon"
                fill="none"
                height="1em"
                stroke="currentColor"
                stroke-linecap="round"
