            </span>
          </label>
          <input
            class="form-control"
            id="root_firstName"
            name="root.firstName"
            placeholder=""
            type="text"
            value=""
          />
        </div>
        <div
          class="form-group rjsf-field rjsf-field-string"
        >
          <label
            class="control-label"
            for="root_lastName"
          >
            <span
              id="root_lastName__label"
            >
              lastName
            </span>
          </label>
          <input
            class="form-control"
            id="root_lastName"
            name="root.lastName"
            placeholder=""
            type="text"
            value=""
          />
        </div>
        <div
          class="form-group rjsf-field rjsf-field-number"
        >
