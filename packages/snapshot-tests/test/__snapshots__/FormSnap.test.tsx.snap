            id="root_firstName"
            label="firstName"
            name="root.firstName"
            placeholder=""
            type="text"
            value=""
          />
        </div>
        <div
          class="form-group rjsf-field rjsf-field-number"
        >
          <label
            class="control-label"
            for="root_age"
          >
            <span
              id="root_age__label"
            >
              age
            </span>
          </label>
          <input
            class="form-control"
            id="root_age"
            inputmode="decimal"
            label="age"
            name="root.age"
            pattern="[+\\-]?(([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+\\-]?[0-9]+)?|[.])"
            placeholder=""
            title="Enter a number"
            type="text"
            value=""
          />
