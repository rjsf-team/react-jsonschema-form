        pattern="[+\\-]?(([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+\\-]?[0-9]+)?|[.])"
        placeholder=""
        title="Enter a number"
        type="text"
        value=""
      />
    </div>
    <div>
      <button
        class="btn btn-info "
        type="submit"
      >
        Submit
      </button>
    </div>
  </form>
</DocumentFragment>
`;

