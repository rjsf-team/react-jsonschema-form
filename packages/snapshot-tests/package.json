{
  "name": "@rjsf/snapshot-tests",
  "version": "6.11.0",
  "type": "module",
  "description": "A set of snapshot tests to be used for testing RJSF theme.",
  "scripts": {
    "build": "tsdown -c ../../tsdown.base.mts",
    "publish-to-npm": "pnpm run build && pnpm publish",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test:update": "vitest run --update",
    "test:watch": "vitest"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "engineStrict": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@rjsf/core": "workspace:^",
    "@rjsf/utils": "workspace:^",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "markdown-to-jsx": "^9.8.2",
    "react": ">=19"
  },
  "devDependencies": {
    "@rjsf/core": "workspace:^",
    "@rjsf/utils": "workspace:^",
    "@rjsf/validator-ajv8": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "markdown-to-jsx": "^9.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjsf-team/react-jsonschema-form.git"
  },
  "author": "Nicolas Perriault <nperriault@mozilla.com>",
  "contributors": [
    "Heath Chiavettone <heath.chiavettone@freenome.com"
  ],
  "keywords": [
    "react",
    "form",
    "json-schema"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rjsf-team/react-jsonschema-form",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@rjsf/source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  }
}
