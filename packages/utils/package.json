{
  "name": "@rjsf/utils",
  "version": "6.11.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "description": "Utility functions for @rjsf/core",
  "exports": {
    ".": {
      "@rjsf/source": "./src/index.ts",
      "default": "./lib/index.js"
