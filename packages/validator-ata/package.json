{
  "name": "@rjsf/validator-ata",
  "version": "6.10.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "description": "ata-validator based validator for @rjsf/core",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compileSchemaValidators": {
      "types": "./lib/compileSchemaValidators.d.ts",
      "default": "./lib/compileSchemaValidators.js"
    },
    "./lib/compileSchemaValidators": {
      "types": "./lib/compileSchemaValidators.d.ts",
      "default": "./lib/compileSchemaValidators.js"
    },
    "./lib": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*.js": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "engineStrict": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.base.mts",
    "cs-check": "oxfmt --check \"{src,test}/**/*.{ts,tsx}\"",
    "cs-format": "oxfmt \"{src,test}/**/*.{ts,tsx}\"",
    "lint": "oxlint src test",
    "precommit": "lint-staged",
    "test": "vitest run"
  },
  "lint-staged": {
    "{src,test}/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "dependencies": {
    "ata-validator": "^1.7.1"
  },
  "peerDependencies": {
    "@rjsf/utils": "workspace:^"
  },
  "devDependencies": {
    "@rjsf/utils": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Mert Can Altin <mertgold60@gmail.com>",
  "contributors": [],
  "keywords": [
    "react-jsonschema-form",
    "jsonschema",
    "json-schema",
    "json",
    "schema",
    "form",
    "react",
    "ata",
    "ata-validator",
    "rjsf-validator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjsf-team/react-jsonschema-form.git"
  },
  "license": "Apache-2.0"
}
