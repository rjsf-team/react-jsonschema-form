{
  "name": "@rjsf/core",
  "version": "6.11.0",
  "description": "A simple React component capable of building HTML forms out of a JSON schema.",
  "scripts": {
    "build": "tsdown -c ../../tsdown.base.mts",
    "publish-to-npm": "pnpm run build && pnpm publish",
    "test": "vitest run",
    "test:debug": "node --inspect-brk ../../node_modules/.bin/vitest --pool=forks",
    "test:watch": "vitest",
    "test-coverage": "vitest run --coverage"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rjsf/source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./markdown": {
      "@rjsf/source": "./src/markdown.tsx",
      "default": "./lib/markdown.js"
    },
    "./lib": "./lib/index.js",
    "./lib/components/formModel.js": null,
    "./lib/components/formState.js": null,
    "./lib/describeUnresolvedComponent.js": null,
    "./lib/fieldLabelForLog.js": null,
    "./lib/hasOptionLabels.js": null,
    "./lib/*.js": "./lib/*.js",
    "./testing": {
      "@rjsf/source": "./src/testing.ts",
      "default": "./lib/testing.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "engineStrict": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@rjsf/utils": "workspace:^",
    "@rjsf/validator-ajv8": "workspace:^",
    "markdown-to-jsx": "^9.10.3",
    "react": ">=19.2"
  },
  "peerDependenciesMeta": {
    "@rjsf/validator-ajv8": {
      "optional": true
    },
    "markdown-to-jsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rjsf/utils": "workspace:^",
    "@rjsf/validator-ajv8": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "@types/json-schema": "^7.0.15",
    "ajv": "^8.20.0",
    "markdown-to-jsx": "^9.8.2"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjsf-team/react-jsonschema-form.git"
  },
  "author": "Nicolas Perriault <nperriault@mozilla.com>",
  "contributors": [
    "Heath Chiavettone <heath.chiavettone@freenome.com"
  ],
  "keywords": [
    "react",
    "form",
    "json-schema"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rjsf-team/react-jsonschema-form",
  "publishConfig": {
    "access": "public"
  }
}
