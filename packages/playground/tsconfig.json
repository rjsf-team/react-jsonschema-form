{
  "extends": "../../tsconfig.base.json",
  "include": ["./"],
  "compilerOptions": {
    // A Vite app, not a library: Vite resolves its imports, Node never does.
    "module": "esnext",
    "moduleResolution": "bundler",
    "composite": false,
    "noEmit": true,
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "resolveJsonModule": true,
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "references": [
    { "path": "../antd" },
    { "path": "../chakra-ui" },
    { "path": "../core" },
    { "path": "../daisyui" },
    { "path": "../fluentui-rc" },
    { "path": "../mui" },
    { "path": "../primereact" },
    { "path": "../react-bootstrap" },
    { "path": "../semantic-ui" },
    { "path": "../shadcn" },
    { "path": "../utils" },
    { "path": "../validator-ajv8" },
    { "path": "../validator-ata" },
    { "path": "../validator-cfworker" }
  ]
}
