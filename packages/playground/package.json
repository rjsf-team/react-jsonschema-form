    "@mantine/dates": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mui/material": "^9.4.0",
    "@rjsf/antd": "workspace:^",
    "@rjsf/chakra-ui": "workspace:^",
    "@rjsf/core": "workspace:^",
    "@rjsf/daisyui": "workspace:^",
    "@rjsf/fluentui-rc": "workspace:^",
    "@rjsf/mantine": "workspace:^",
