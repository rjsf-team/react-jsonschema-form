{
  "name": "@rjsf/playground",
  "version": "6.11.0",
  "description": "rjsf playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rimraf build && cross-env NODE_ENV=production vite build",
    "publish-to-gh-pages": "pnpm run build && gh-pages --dist build/",
    "publish-to-npm": "pnpm run build && pnpm publish",
    "start": "vite --force",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "lib",
    "src"
  ],
  "engineStrict": false,
