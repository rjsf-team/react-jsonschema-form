{
  "name": "@rjsf/playground",
  "version": "6.10.0",
  "description": "rjsf playground",
  "private": true,
  "type": "module",
  "scripts": {
    "cs-check": "oxfmt --check \"src/**/*.{ts,tsx}\"",
    "cs-format": "oxfmt \"src/**/*.{ts,tsx}\"",
    "build": "rimraf build && cross-env NODE_ENV=production vite build",
    "lint": "oxlint src",
    "precommit": "lint-staged",
    "publish-to-gh-pages": "pnpm run build && gh-pages --dist build/",
    "publish-to-npm": "pnpm run build && pnpm publish",
    "start": "vite --force",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "files": [
    "dist",
    "lib",
    "src"
  ],
  "engineStrict": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@ant-design/cssinjs": "^2.1.2",
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^9.6.1",
    "@mantine/dates": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mui/material": "^9.1.2",
    "@rjsf/antd": "workspace:^",
    "@rjsf/chakra-ui": "workspace:^",
    "@rjsf/core": "workspace:^",
    "@rjsf/daisyui": "workspace:^",
    "@rjsf/fluentui-rc": "workspace:^",
    "@rjsf/mantine": "workspace:^",
    "@rjsf/mui": "workspace:^",
    "@rjsf/primereact": "workspace:^",
    "@rjsf/react-bootstrap": "workspace:^",
    "@rjsf/shadcn": "workspace:^",
    "@rjsf/utils": "workspace:^",
    "@rjsf/validator-ajv8": "workspace:^",
    "@rjsf/validator-ata": "workspace:^",
    "@rjsf/validator-cfworker": "workspace:^",
    "ajv": "^8.20.0",
    "ajv-i18n": "^4.2.0",
    "antd": "^6.4.3",
    "chakra-react-select": "^6.1.3",
    "dayjs": "^1.11.21",
    "monaco-editor": "^0.55.1",
    "primereact": "^10.9.8",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-frame-component": "^5.3.2",
    "react-resizable-panels": "^4.11.2"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.1.1",
    "@vitejs/plugin-react": "^6.0.2",
    "gh-pages": "^6.3.0",
    "vite": "8.0.16"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjsf-team/react-jsonschema-form.git"
  },
  "author": "Nicolas Perriault <nperriault@mozilla.com>",
  "contributors": [
    "Heath Chiavettone <heath.chiavettone@freenome.com"
  ],
  "keywords": [
    "react",
    "react 17",
    "form",
    "json-schema"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/rjsf-team/react-jsonschema-form",
  "publishConfig": {
    "access": "public"
  }
}
