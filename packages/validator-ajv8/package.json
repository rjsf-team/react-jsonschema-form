{
  "name": "@rjsf/validator-ajv8",
  "version": "6.10.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "description": "The ajv-8 based validator for @rjsf/core",
  "exports": {
    ".": {
      "@rjsf/source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./compileSchemaValidators": {
      "@rjsf/source": "./src/compileSchemaValidators.ts",
      "default": "./lib/compileSchemaValidators.js"
    },
    "./lib/compileSchemaValidators": "./lib/compileSchemaValidators.js",
    "./lib": "./lib/index.js",
    "./lib/*.js": "./lib/*.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "engineStrict": false,
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown -c ../../tsdown.base.mts",
    "cs-check": "oxfmt --check \"{src,test}/**/*.{ts,tsx}\"",
    "cs-format": "oxfmt \"{src,test}/**/*.{ts,tsx}\"",
    "lint": "oxlint src test",
    "precommit": "lint-staged",
    "test": "vitest run"
  },
  "lint-staged": {
    "{src,test}/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1"
  },
  "peerDependencies": {
    "@rjsf/utils": "workspace:^"
  },
  "devDependencies": {
    "@rjsf/utils": "workspace:^",
    "ajv-i18n": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Heath Chiavettone <heath.chiavettone@freenome.com",
  "contributors": [],
  "keywords": [
    "react-jsonschema-form",
    "jsonschema",
    "json-schema",
    "json",
    "schema",
    "form",
    "react",
    "ajv-8",
    "rjsf-validator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjsf-team/react-jsonschema-form.git"
  },
  "license": "Apache-2.0"
}
