{
  "extends": "nx/presets/npm.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "//": "outputs = nx's defaults (dist/build/public) plus lib/, which the packages' build:ts emits; without it a cache hit reports success without restoring lib/ to disk",
      "outputs": ["{projectRoot}/lib", "{projectRoot}/dist", "{projectRoot}/build", "{projectRoot}/public"]
    },
    "cs-check": {
      "cache": true
    },
    "cs-format": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true,
      "//test": "the shared vitest base/setup live outside project roots; without these inputs a warm cache serves stale results when they change",
      "inputs": ["default", "^default", "{workspaceRoot}/testing/*", "{workspaceRoot}/vitest.config.ts"]
    },
    "test:update": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/testing/*", "{workspaceRoot}/vitest.config.ts"]
    },
    "test:watch": {
      "cache": true
    },
    "precommit": {
      "cache": true
    },
    "publish-to-npm": {
      "cache": true
    },
    "test-coverage": {
      "cache": true
    },
    "build:lib": {
      "cache": true
    },
    "prepublishOnly": {
      "cache": true
    },
    "build:dist": {
      "cache": true
    },
    "publish-to-gh-pages": {
      "cache": true
    }
  },
  "useInferencePlugins": false,
  "defaultBase": "main",
  "useLegacyCache": true,
  "release": {
    "projects": ["*"],
    "version": {
      "generatorOptions": {
        "updateDependents": "always"
      }
    }
  },
  "analytics": true
}
