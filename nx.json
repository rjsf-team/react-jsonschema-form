{
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false
    }
  },
  "extends": "nx/presets/npm.json",
  "targetDefaults": {
    "build:ts": {
      "dependsOn": ["^build:ts"],
      "cache": true,
      "//": "the tsc-only lib/ build, measured by size-limit; declaring lib/ as an output means a cache hit restores it to disk, and the tsbuildinfo keeps the next tsc -b incremental",
      "outputs": ["{projectRoot}/lib", "{projectRoot}/tsconfig.tsbuildinfo"]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "//": "outputs = nx's defaults (dist/build/public) plus lib/ and the tsbuildinfo that build:ts emits; without lib/ a cache hit reports success without restoring it to disk, and without the tsbuildinfo the next tsc -b after a restore does a needless full rebuild",
      "outputs": [
        "{projectRoot}/lib",
        "{projectRoot}/tsconfig.tsbuildinfo",
        "{projectRoot}/dist",
        "{projectRoot}/build",
        "{projectRoot}/public"
      ]
    },
    "cs-check": {
      "cache": true
    },
    "cs-format": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true,
      "//test": "the shared vitest base/setup live outside project roots; without these inputs a warm cache serves stale results when they change",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/testing/*",
        "{workspaceRoot}/vitest.config.ts"
      ]
    },
    "test:update": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/testing/*",
        "{workspaceRoot}/vitest.config.ts"
      ]
    },
    "test:watch": {
      "cache": true
    },
    "precommit": {
      "cache": true
    },
    "publish-to-npm": {
      "cache": true
    },
    "test-coverage": {
      "cache": true
    },
    "build:lib": {
      "cache": true
    },
    "prepublishOnly": {
      "cache": true
    },
    "build:dist": {
      "cache": true
    },
    "publish-to-gh-pages": {
      "cache": true
    }
  },
  "useInferencePlugins": false,
  "defaultBase": "main",
  "useLegacyCache": true,
  "release": {
    "projects": [
      "*"
    ],
    "version": {
      "generatorOptions": {
        "updateDependents": "always"
      }
    }
  },
  "analytics": true,
  "neverConnectToCloud": true
}
