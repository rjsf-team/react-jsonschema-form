{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "jsxSingleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": ["packages/docs/versioned_docs/**"],
  "overrides": [
    {
      // A docs snippet is often a fragment, not a full program, and formatting it as one changes what it shows
      "files": ["**/*.md", "**/*.mdx"],
      "options": { "embeddedLanguageFormatting": "off" }
    }
  ],
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react"]
      }
    ],
    "groups": [
      "react",
      ["builtin", "external", "type-builtin", "type-external"],
      { "newlinesBetween": true },
      [
        "internal",
        "subpath",
        "parent",
        "sibling",
        "index",
        "type-internal",
        "type-parent",
        "type-sibling",
        "type-index"
      ],
      "style",
      "unknown"
    ]
  }
}
