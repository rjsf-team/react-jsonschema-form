{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    // @rjsf/chakra-ui: @chakra-ui/react's declarations do not resolve under "nodenext" (see packages/chakra-ui/tsconfig.lib.json).
    // The playground is a Vite app, so a bundler's resolution is the one it runs under; its Vite globals come from
    // packages/playground/src/vite-env.d.ts
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "packages/chakra-ui/src",
    "packages/chakra-ui/test",
    "packages/playground/src",
    "packages/playground/test",
    "packages/playground/*.ts"
  ],
  "exclude": []
}
