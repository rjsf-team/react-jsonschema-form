{
  // The whole repo as one program, resolving @rjsf/* imports to source, so TypeScript resolves the shared T/S/F type
  // graph once rather than once per package.
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "composite": false,
    "incremental": true,
    "resolveJsonModule": true,
    "customConditions": ["@rjsf/source"],
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vitest/globals", "node", "@testing-library/jest-dom/vitest"]
  },
  "include": ["packages/*/src", "packages/*/test", "testing"],
  // chakra-ui and the playground need "bundler" resolution, so they're in tsconfig.typecheck-bundler.json
  "exclude": ["packages/chakra-ui", "packages/docs", "packages/playground"]
}
