{
  // Every package but chakra-ui and the playground (see tsconfig.typecheck-bundler.json) as one program, resolving
  // @rjsf/* imports to source, so TypeScript resolves the shared T/S/F type graph once rather than once per package.
  // The tests' Node and Vitest globals and modules are visible in `src` too, so the .oxlintrc.json override for the
  // published packages' `src` is what keeps published code off them
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/typecheck/main.tsbuildinfo",
    "customConditions": ["@rjsf/source"]
  },
  "include": ["packages/*/src", "packages/*/test", "testing"],
  // chakra-ui and the playground need "bundler" resolution, so they're in tsconfig.typecheck-bundler.json
  "exclude": ["packages/chakra-ui", "packages/docs", "packages/playground"]
}
