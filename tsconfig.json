{
  // Editors and type-aware lint open the nearest tsconfig.json and use the first referenced program that contains the
  // file, so pointing at the typecheck programs gives both the one shared T/S/F type graph instead of one per package
  "files": [],
  "references": [{ "path": "./tsconfig.typecheck.json" }, { "path": "./tsconfig.typecheck-bundler.json" }]
}
