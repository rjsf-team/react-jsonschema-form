{
  // The shared snapshot suites and vitest config, which both the test and playground programs import. Emitting their
  // declarations lets both reference them rather than each re-checking the source
  "extends": "./tsconfig.typecheck-test.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": ".",
    "outDir": "node_modules/.cache/typecheck/shared"
  },
  "include": ["packages/snapshot-tests/src", "testing"],
  "exclude": [],
  "references": [{ "path": "./tsconfig.typecheck.json" }, { "path": "./tsconfig.typecheck-node.json" }]
}
