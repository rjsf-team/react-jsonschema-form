{
  "name": "react-jsonschema-form",
  "private": true,
  "type": "module",
  "description": "monorepo for react-jsonschema-form and its themes",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "test": "nx run-many --parallel=2 --target=test",
    "test:update": "nx run-many --parallel=2 --target=test:update",
    "lint": "oxlint --type-check",
    "knip": "rimraf packages/*/lib && knip && knip --production --workspace packages/utils --include exports --tags=-testSeam",
    "cs-check": "oxfmt --check",
    "cs-format": "oxfmt",
    "clean-build": "rimraf packages/*/lib && pnpm run build",
    "build": "nx run-many --target=build",
    "build-serial": "nx run-many --target=build --parallel=1",
    "start": "echo 'use \"pnpm run build\" from main directory and then \"pnpm start\" in the playground package'",
    "prepare": "is-ci || husky",
    "bump-all-packages": "echo 'NOTE: Make sure to sanity check the playground locally before commiting changes' && pnpm update --latest && pnpm install && pnpm run cs-format && pnpm run sanity-check",
    "refresh-node-modules": "rimraf packages/*/node_modules && rimraf node_modules && pnpm install",
    "update-version-tags": "git tag -f $(node scripts/get-version-tag.cjs) && git push -f origin $(node scripts/get-version-tag.cjs)",
    "nuke-build-env": "rimraf .nx && rimraf pnpm-lock.yaml",
    "sanity-check": "pnpm run cs-check && pnpm run lint && pnpm run knip && pnpm run build && pnpm run test"
  },
  "lint-staged": {
    "pnpm-lock.yaml": "sh -c 'pnpm dedupe --check'",
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/rjsf-team/react-jsonschema-form",
  "devDependencies": {
    "@nx/js": "23.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jsdom": "~30.1.3",
    "jsdom-testing-mocks": "^1.16.0",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "nx": "23.2.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "tsdown": "0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "packages/antd",
    "packages/bootstrap3",
    "packages/chakra-ui",
    "packages/core",
    "packages/daisyui",
    "packages/docs",
    "packages/fluentui-rc",
    "packages/mantine",
    "packages/mui",
    "packages/playground",
    "packages/react-bootstrap",
    "packages/utils",
    "packages/validator-ajv8",
    "packages/validator-ata",
    "packages/validator-cfworker",
    "packages/snapshot-tests",
    "packages/shadcn"
  ],
  "packageManager": "pnpm@12.8.1"
}
